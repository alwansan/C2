# Service must run on a network that can access Cinemana. Do not commit credentials.
HOST=127.0.0.1
PORT=7000
PUBLIC_URL=http://127.0.0.1:7000
DATA_DIR=./data
CINEMANA_API_BASE=https://cinemana.shabakaty.cc/api/android/
# Optional legitimate access token; keep the exact header value, no automatic Bearer prefix.
CINEMANA_AUTHORIZATION=
CINEMANA_USER_AGENT=Android 15; Cinemana -1; AlwanCinema Addon
# Optional headers for VIDEO requests, a JSON object. Never copies API authorization.
CINEMANA_MEDIA_HEADERS={}
REQUEST_TIMEOUT_MS=12000
PAGES_PER_REQUEST=40
CATALOG_TTL_MS=900000
# For access from other devices on a reachable LAN/public network:
# HOST=0.0.0.0
# Optional private installation key: installed URL becomes /k/<key>/manifest.json.
ADDON_ACCESS_KEY=
